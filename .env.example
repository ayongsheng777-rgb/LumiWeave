# 绵绣 LumiWeave 环境变量示例
# 复制为 .env 并按需修改

# PostgreSQL
POSTGRES_USER=lumiweave
POSTGRES_PASSWORD=lumiweave2026
POSTGRES_DB=lumiweave
POSTGRES_PORT=5435
DATABASE_URL=postgresql://lumiweave:lumiweave2026@postgres:5432/lumiweave

# Redis
REDIS_PORT=6385
REDIS_URL=redis://redis:6379/0

# 服务端口
BACKEND_PORT=8900
FRONTEND_PORT=3010

# OTP 认证
OTP_ISSUER=绵绣LumiWeave
OTP_ACCOUNT=admin@lumiweave
# 固定密钥模式：设置 OTP_SECRET 后首屏不再展示二维码，由管理员私下下发
OTP_SECRET=
SESSION_TTL=43200
# 会话签名密钥，留空则自动生成并落盘
SESSION_SECRET=

# AI 默认配置
AI_ENABLED=true
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=your-api-key
AI_MODEL=deepseek-chat
# 容器内访问宿主代理用 http://host.docker.internal:1080；国内模型通常留空
AI_PROXY=
AI_USER_AGENT=
# 多模型库 JSON，示例见 README
AI_MODELS_JSON=[]
AI_ACTIVE=default

# 飞书日报推送（可选）
FEISHU_WEBHOOK_URL=

# 前端 API 路径
VITE_API_BASE_URL=/api
